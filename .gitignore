# Keep publication source-only. Experiment artifacts may contain private code.
/*
!/*.py
!/README.md
!/LICENSE
!/.gitignore
!/graphify/
/graphify/*
!/graphify/run.py
!/graphify/requirements.lock
__pycache__/
*.pyc
.DS_Store
.env*

!/docs/
/docs/*
!/docs/*.md

# Reviewed, public documentation image only.
!/docs/assets/
/docs/assets/*
!/docs/assets/results.png
